# ---------------------------------------------------------------------------
# Pizarro Multi-AI Orchestrator — environment template
#
# Copy this file to .env.local and fill in the keys you have:
#     cp .env.example .env.local
#
# .env.local is git-ignored. NEVER commit real keys.
# Every key here is read server-side only; none is exposed to the browser.
# A provider without a key is reported as "Provider not configured" — it is
# never silently replaced with a fake answer.
# ---------------------------------------------------------------------------

# --- Providers (set at least one) ------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is the cheap default; gemini-2.5-pro is stronger for judging.
GEMINI_MODEL=gemini-2.5-flash

# Override only if you use a proxy or gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Cost controls ----------------------------------------------------------
# Hard cap on generated tokens per provider call.
MAX_OUTPUT_TOKENS=1024
# Wall-clock budget for one provider call, in milliseconds.
REQUEST_TIMEOUT_MS=60000
# Retries for transient failures only (timeouts, 429s, 5xx). Max 5.
MAX_RETRIES=2
# Longest task the API will accept, in characters.
MAX_TASK_LENGTH=20000
# Hard ceiling on provider calls in ONE workflow. This is the stopping
# condition that makes runaway agent loops impossible.
MAX_PROVIDER_CALLS_PER_RUN=8
# Comma-separated provider ids to switch off regardless of keys, e.g. "perplexity".
DISABLED_PROVIDERS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Rate-limit callers by X-Forwarded-For. Leave false unless the app sits behind
# a proxy YOU control that overwrites that header — otherwise a caller can forge
# it and give itself an unlimited number of fresh buckets. When false, all
# callers share one bucket, which still caps total spend.
TRUST_PROXY_HEADERS=false

# --- Storage ----------------------------------------------------------------
# sqlite (default, file-backed) or memory (history cleared on restart).
STORE_DRIVER=sqlite
DB_PATH=./data/orchestrator.db

# --- Development only -------------------------------------------------------
# Adds a FAKE provider whose output is clearly labelled "[MOCK RESPONSE — NOT A
# REAL MODEL]". For UI/plumbing work without keys. Never enable in production.
ENABLE_MOCK_PROVIDER=false

# debug | info | warn | error | silent
LOG_LEVEL=info
